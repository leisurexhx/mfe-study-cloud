# Copy to .env for development. Never commit real values.
MFE_ENV=development
MFE_APP_NAME=MFE Study Cloud
MFE_PUBLIC_BASE_URL=http://localhost:8080
MFE_SESSION_SECRET=replace-with-at-least-32-random-characters
MFE_DATABASE_URL=postgresql+psycopg://mfe:mfe-development-only@postgres:5432/mfe
MFE_OBJECT_ENDPOINT=http://minio:9000
MFE_OBJECT_REGION=us-east-1
MFE_OBJECT_BUCKET=mfe-study
MFE_OBJECT_ACCESS_KEY=mfe-development-only
MFE_OBJECT_SECRET_KEY=mfe-development-only-secret
MFE_OBJECT_SECURE=false

# fake is safe for demos and CI. Set to openai only on a trusted server.
MFE_ANALYSIS_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=
MFE_OPENAI_REASONING_EFFORT=medium
MFE_OPENAI_PDF_DETAIL=high
MFE_ANALYSIS_BATCH_PAGES=5
MFE_ANALYSIS_MAX_DOCUMENT_PAGES=500
MFE_ANALYSIS_MAX_CONCURRENT_JOBS=2
MFE_ANALYSIS_MAX_OUTPUT_TOKENS=20000
MFE_ANALYSIS_MAX_INPUT_BYTES=52428800
MFE_ANALYSIS_JOB_LEASE_SECONDS=300
MFE_ANALYSIS_MAX_ATTEMPTS=3
MFE_WORKER_POLL_SECONDS=2

MFE_WEB_HOST=0.0.0.0
MFE_WEB_PORT=8080
MFE_MAX_UPLOAD_BYTES=52428800
MFE_SECURE_COOKIES=false
MFE_ALLOWED_HOSTS=localhost,127.0.0.1
MFE_LOG_LEVEL=INFO
